msgid "Enable Sameday at checkout"
msgstr "Включи Sameday в поръчката"

#: class-drushfs-shipping-method.php:90
msgid "Method title"
msgstr "Заглавие на метода"

#: class-drushfs-shipping-method.php:92
msgid "Shown to the customer at checkout."
msgstr "Показва се на клиента при поръчка."

