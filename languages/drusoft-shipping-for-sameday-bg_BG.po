#. Plugin Name of the plugin
#: drusoft-shipping-for-sameday.php
msgid "Drusoft Shipping for Sameday"
msgstr "Drusoft Shipping for Sameday"

#. Plugin URI of the plugin
#: drusoft-shipping-for-sameday.php
msgid "https://github.com/ventzie555/drusoft-shipping-for-sameday"
msgstr "https://github.com/ventzie555/drusoft-shipping-for-sameday"

#. Description of the plugin
#: drusoft-shipping-for-sameday.php
msgid ""
"A clean, conflict-free Sameday integration for Bulgaria — live prices, "
"easybox and address delivery, waybills and labels."
msgstr ""
"Изчистена интеграция със Sameday за България без конфликти — цени на живо, "
"доставка до адрес и до easybox, товарителници и етикети."

#. Author of the plugin
#: drusoft-shipping-for-sameday.php
msgid "DRUSOFT LTD"
msgstr "ДРУСОФТ ЕООД"

#. Author URI of the plugin
#: drusoft-shipping-for-sameday.php
msgid "https://drusoft.dev/"
msgstr "https://drusoft.dev/"

#: class-drushfs-shipping-method.php:46 drusoft-shipping-for-sameday.php:881
msgid "Sameday"
msgstr "Sameday"

#: class-drushfs-shipping-method.php:47
msgid ""
"Delivery to an address, an easybox or a SAMEDAY point, priced by Sameday."
msgstr "Доставка до адрес, до easybox или до SAMEDAY point с цени от Sameday."

#: class-drushfs-shipping-method.php:64 class-drushfs-shipping-method.php:93
msgid "Sameday delivery"
msgstr "Доставка със Sameday"

#: class-drushfs-shipping-method.php:80
msgid "Sameday API"
msgstr "Sameday API"

#: class-drushfs-shipping-method.php:84
msgid "Module status"
msgstr "Статус на модула"

